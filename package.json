{
  "name": "cardsafe",
  "productName": "CARDSAFE",
  "version": "1.3.5",
  "description": "跨平台素材拷卡与校验工具 (macOS / Windows 11)",
  "main": "electron/main.js",
  "author": "CardSafe",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test:engine": "node test/engine.test.js",
    "test:e2e": "node scripts/e2e.js",
    "test:update": "node test/updater.test.js",
    "test": "node test/engine.test.js && node test/updater.test.js",
    "release": "node scripts/release.js",
    "serve:update": "node scripts/dev-update-server.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder -mwl"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "nodemailer": "^6.9.13"
  },
  "build": {
    "appId": "net.cardsafe.app",
    "productName": "CARDSAFE",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "icon": "build/icon.icns"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "CardSafe"
    },
    "dmg": {
      "icon": "build/icon.icns",
      "title": "CARDSAFE ${version}"
    }
  }
}
